#!/usr/bin/env bash
set -euo pipefail
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
ENVFILE="$CFG/hyprx/theme.env"
[[ -f "$ENVFILE" ]] || { echo "Missing palette: $ENVFILE" >&2; exit 1; }
# shellcheck disable=SC1090
source "$ENVFILE"
hex(){ printf '%s' "${1#\#}"; }
rgb(){ local h="${1#\#}"; printf "%d,%d,%d" "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"; }
BG="$(hex "$HYPRX_BG")"; SURFACE="$(hex "$HYPRX_SURFACE")"; FG="$(hex "$HYPRX_FG")"; MUTED="$(hex "$HYPRX_MUTED")"; ACCENT="$(hex "$HYPRX_ACCENT")"; BORDER="$(hex "$HYPRX_BORDER")"
UI_FONT="${HYPRX_UI_FONT:-Inter Variable}"
MONO_FONT="${HYPRX_MONO_FONT:-JetBrainsMono Nerd Font Mono}"

mkdir -p "$CFG/hypr/modules" "$CFG/kitty" "$CFG/rofi" "$CFG/kdeglobals.d"
cat > "$CFG/hypr/modules/colors.lua" <<EOT
-- Generated by HyprX. Do not hand-edit.
hl.config({
    general = {
        col = {
            active_border = "rgb($ACCENT)",
            inactive_border = "rgb($BORDER)",
        },
    },
})
EOT
cat > "$CFG/kitty/hyprx-theme.conf" <<EOT
# Generated by HyprX
background #09090b
foreground #$FG
selection_background #$ACCENT
selection_foreground #09090b
cursor #$ACCENT
cursor_text_color #09090b
color0 #09090b
color1 #f38ba8
color2 #a6e3a1
color3 #f9e2af
color4 #$ACCENT
color5 #cba6f7
color6 #94e2d5
color7 #$FG
color8 #$MUTED
color9 #f38ba8
color10 #a6e3a1
color11 #f9e2af
color12 #$ACCENT
color13 #cba6f7
color14 #94e2d5
color15 #ffffff
EOT
cat > "$CFG/rofi/hyprx-theme.rasi" <<EOT
* { bg: #09090bee; surface: #111114f2; fg: #$FG; muted: #$MUTED; accent: #$ACCENT; border: #2a2a2f; font: "$UI_FONT 11"; }
window { background-color: @bg; border: 0px; border-radius: 16px; padding: 12px; width: 560px; }
mainbox { background-color: transparent; spacing: 8px; }
inputbar { background-color: @surface; border-radius: 11px; padding: 10px; text-color: @fg; }
listview { background-color: transparent; lines: 8; spacing: 4px; }
element { background-color: transparent; border-radius: 10px; padding: 8px; text-color: @fg; }
element selected { background-color: @surface; text-color: @fg; }
element-icon { size: 28px; }
element-text { text-color: inherit; }
EOT
cat > "$CFG/kdeglobals" <<EOT
[General]
ColorScheme=HyprX
font=$UI_FONT,10,-1,5,50,0,0,0,0,0
fixed=$MONO_FONT,10,-1,5,50,0,0,0,0,0

[Colors:Window]
BackgroundNormal=9,9,11
ForegroundNormal=$(rgb "#$FG")

[Colors:View]
BackgroundNormal=14,14,17
ForegroundNormal=$(rgb "#$FG")
DecorationFocus=$(rgb "#$ACCENT")

[Colors:Selection]
BackgroundNormal=$(rgb "#$ACCENT")
ForegroundNormal=9,9,11

[Icons]
Theme=Papirus-Dark
EOT

hyprctl reload >/dev/null 2>&1 || true
