#!/usr/bin/env bash
set -euo pipefail
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$CFG/hyprx/surface.txt"
mode="${1:-$(cat "$STATE" 2>/dev/null || printf minimal)}"
case "$mode" in
  matte) opacity=1.00 ;;
  minimal) opacity=0.92 ;;
  gloss) opacity=0.86 ;;
  glass) opacity=0.76 ;;
  *) echo 'Usage: hyprx-surface {matte|minimal|gloss|glass}' >&2; exit 2 ;;
esac
mkdir -p "$CFG/hyprx" "$CFG/kitty"
printf '%s\n' "$mode" > "$STATE"
cat > "$CFG/kitty/hyprx-surface.conf" <<EOT
# Generated by HyprX — $mode surface
background_opacity $opacity
dynamic_background_opacity yes
EOT
printf 'HyprX surface: %s\n' "$mode"
